# ============================================================
# Financial Projection Platform — Environment Variables
# Copy to .env.dev for local development
# NEVER commit actual .env files to git
# ============================================================

# GCP Project
GCP_PROJECT_ID=financial-dev
GCP_REGION=us-central1

# Pub/Sub
PUBSUB_PROJECT_ID=financial-dev
PUBSUB_EMULATOR_HOST=localhost:8085   # Remove in production
PUBSUB_MARKET_EVENTS_TOPIC=market-events
PUBSUB_MARKET_EVENTS_SUBSCRIPTION=market-events-sub
PUBSUB_SENTIMENT_EVENTS_TOPIC=sentiment-events
PUBSUB_SENTIMENT_EVENTS_SUBSCRIPTION=sentiment-events-sub

# Database
POSTGRES_URL=postgresql+asyncpg://financial:financial_dev_password@localhost:5432/financial
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=10

# Google Cloud Storage
GCS_BUCKET_RAW=financial-raw-dev
GCS_BUCKET_MODELS=financial-models-dev
GCS_EMULATOR_HOST=http://localhost:4443   # Remove in production

# BigQuery
BIGQUERY_DATASET=financial_data
BIGQUERY_PRICES_TABLE=prices
BIGQUERY_PROJECTIONS_TABLE=projections

# ============================================================
# External API Keys — Replace with real keys
# ============================================================

# Market Data
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
METALPRICEAPI_KEY=your_metalpriceapi_key_here
METALS_API_KEY=your_metals_api_key_here
MARKETSTACK_API_KEY=your_marketstack_key_here
OPEN_EXCHANGE_RATES_APP_ID=your_openexchangerates_app_id_here

# Institutional Data
WORLD_GOLD_COUNCIL_API_KEY=your_wgc_key_here
COMEX_API_KEY=your_comex_key_here

# Alternative Data
EOSDA_API_KEY=your_eosda_key_here
SHIPSDNA_API_KEY=your_shipsdna_key_here
# OpenSky Network uses public API (no key required for basic access)

# AI / NLP
PERPLEXITY_API_KEY=your_perplexity_api_key_here
PERPLEXITY_MODEL=sonar-pro

# Vector Databases
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=financial-embeddings
PINECONE_SEMANTIC_CACHE_THRESHOLD=0.92

MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=historical_embeddings

# ============================================================
# ML Configuration
# ============================================================
LSTM_SEQUENCE_LENGTH=60
LSTM_HIDDEN_SIZE=256
LSTM_NUM_LAYERS=3
LSTM_DROPOUT=0.2
XGBOOST_N_ESTIMATORS=500
XGBOOST_MAX_DEPTH=6
MONTE_CARLO_PATHS=10000
MONTE_CARLO_HORIZON_DAYS=30
BERT_MODEL_NAME=bert-base-uncased

# ============================================================
# API Gateway
# ============================================================
JWT_SECRET_KEY=change_this_in_production_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
API_RATE_LIMIT_PER_MINUTE=100

# ============================================================
# Service URLs (local dev)
# ============================================================
ML_SERVICE_URL=http://localhost:8002
SENTIMENT_SERVICE_URL=http://localhost:8003
INGESTION_SERVICE_URL=http://localhost:8001

# ============================================================
# Observability
# ============================================================
LOG_LEVEL=INFO
ENABLE_TRACING=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
